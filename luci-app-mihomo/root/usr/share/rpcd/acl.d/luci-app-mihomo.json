{
	"luci-app-mihomo": {
		"description": "Grant access to Mihomo configuration and service status",
		"read": {
			"uci": [ "mihomo" ],
			"ubus": {
				"service": [ "list" ],
				"file": [ "list", "stat", "read", "exec" ]
			},
			"file": {
				"/etc/mihomo/*": [ "read" ],
				"/etc/mihomo": [ "list" ],
				"/usr/libexec/mihomo-core": [ "exec" ]
			}
		},
		"write": {
			"uci": [ "mihomo" ],
			"cgi-io": [ "upload" ],
			"ubus": {
				"file": [ "write", "remove", "exec" ]
			},
			"file": {
				"/etc/mihomo/*": [ "write" ]
			}
		}
	}
}
