config mihomo 'config'
	option enabled '0'
	option config_path '/etc/mihomo/config.yaml'
	option proxy_mode 'tproxy'
	list proxy_ifaces 'br-lan'
	option proxy_udp '1'
	option tproxy_port '7893'
	option dns_port '1053'
	option ui_port '9090'
	option auto_restart '0'
	option restart_type 'daily'
	option restart_hour '4'
	option restart_min '0'
	option restart_interval '6'
	option restart_cron '0 4 * * *'
